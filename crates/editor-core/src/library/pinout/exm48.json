 "rules": [
  {
   "label": "uart0_pin_set",
   "script": "if (active(\"P0_2\", \"uart0_tx\") || active(\"P0_3\", \"uart0_rx\")) && (active(\"P1_6\", \"uart0_tx\") || active(\"P1_7\", \"uart0_rx\")) {\n    forbid(\"UART0 uses one pin set: P0_2/P0_3 or P1_6/P1_7.\", [\"P0_2\", \"P0_3\", \"P1_6\", \"P1_7\"])\n} else {\n    ok()\n}",
   "source": {
    "page": 30,
    "table": "Table 11"
   }
  },
  {
   "label": "spi0_i2c0_shared_block",
   "script": "if used(\"SPI0\") && used(\"I2C0\") {\n    forbid(\"SPI0 and I2C0 share one serial block on this die.\")\n} else {\n    ok()\n}",
   "source": {
    "page": 30,
    "table": "Table 11"
   }
  },
  {
   "label": "uart0_flow_control",
   "script": "if role(\"UART0\", \"rts\") && !role(\"UART0\", \"cts\") {\n    require(\"UART0 flow control needs CTS whenever RTS is used.\", [\"P0_0\"])\n} else {\n    ok()\n}",
   "source": {
    "page": 30,
    "table": "Table 11"
   }
  },
  {
   "label": "swd_as_gpio",
   "script": "if active(\"P0_13\", \"gpio_in\") || active(\"P0_13\", \"gpio_out\") || active(\"P0_14\", \"gpio_in\") || active(\"P0_14\", \"gpio_out\") {\n    warn(\"Using the SWD pins as GPIO disables debugging.\", [\"P0_13\", \"P0_14\"])\n} else {\n    ok()\n}",
   "source": {
    "page": 31,
    "table": "Section 6.2"
   }
  }
 ]
